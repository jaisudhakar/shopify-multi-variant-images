{%- comment -%}
  Outputs the data the storefront script needs to filter images by colour.

  Accepts:
  - product: {Object} The product
  - fallback: {String} "all" | "shared" — what to show for colours without images
  - include_shared: {Boolean} Append images not assigned to any colour
  - item_selector: {String} (theme gallery only) CSS selector of gallery items
{%- endcomment -%}
{%- assign mvi_config = product.metafields['$app'].variant_images.value -%}
<script type="application/json" data-mvi-data>
  {
    "productId": {{ product.id | json }},
    "config": {{ mvi_config | json }},
    "options": [
      {%- for option in product.options_with_values -%}
        {
          "name": {{ option.name | json }},
          "position": {{ option.position | json }},
          "values": [
            {%- for value in option.values -%}
              { "id": {{ value.id | json }}, "name": {{ value.name | json }} }
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "variants": [
      {%- for variant in product.variants -%}
        { "id": {{ variant.id | json }}, "options": {{ variant.options | json }} }
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "media": [
      {%- for media in product.media -%}
        {{ media.id | json }}
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "initialVariantId": {{ product.selected_or_first_available_variant.id | json }},
    "settings": {
      "fallback": {{ fallback | default: 'all' | json }},
      "includeShared": {% if include_shared %}true{% else %}false{% endif %},
      "itemSelector": {{ item_selector | default: '' | json }}
    }
  }
</script>
