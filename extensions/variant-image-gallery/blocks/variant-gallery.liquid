{%- comment -%}
  App block: a self-contained product gallery that only shows the images
  assigned to the selected colour. Use it in themes whose own gallery can't
  be filtered by the app embed.
{%- endcomment -%}
{%- assign mvi_product = block.settings.product | default: product -%}
{%- if mvi_product and mvi_product.media.size > 0 -%}
  {%- liquid
    case block.settings.aspect_ratio
      when 'square'
        assign mvi_ratio = '1 / 1'
      when 'portrait'
        assign mvi_ratio = '3 / 4'
      when 'landscape'
        assign mvi_ratio = '4 / 3'
      else
        assign mvi_ratio = mvi_product.featured_media.preview_image.aspect_ratio | default: 1
    endcase
  -%}
  <div
    class="mvi-gallery mvi-gallery--thumbs-{{ block.settings.thumbnails }}"
    style="--mvi-ratio: {{ mvi_ratio }}; --mvi-fit: {{ block.settings.image_fit }}; --mvi-radius: {{ block.settings.corner_radius }}px;"
    data-mvi-root
    data-mvi-mode="block"
    {{ block.shopify_attributes }}
  >
    {%- render 'mvi-product-data',
      product: mvi_product,
      fallback: block.settings.fallback,
      include_shared: block.settings.include_shared
    -%}

    <div class="mvi-gallery__viewport">
      <ul class="mvi-gallery__track" data-mvi-track role="list">
        {%- for media in mvi_product.media -%}
          <li
            class="mvi-gallery__slide"
            data-mvi-media-id="{{ media.id }}"
            aria-label="{{ forloop.index }} / {{ mvi_product.media.size }}"
          >
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {{
                  media
                  | image_url: width: 1800
                  | image_tag:
                    widths: '360, 540, 720, 900, 1080, 1296, 1512, 1800',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    loading: 'lazy',
                    alt: media.alt
                }}
              {%- when 'video' -%}
                {{ media | video_tag: controls: true, playsinline: true, preload: 'metadata' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
            {%- endcase -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if block.settings.show_arrows -%}
        <button type="button" class="mvi-gallery__arrow mvi-gallery__arrow--prev" data-mvi-prev aria-label="{{ 'gallery.previous' | t }}">
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="mvi-gallery__arrow mvi-gallery__arrow--next" data-mvi-next aria-label="{{ 'gallery.next' | t }}">
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      {%- endif -%}
      <span class="mvi-gallery__counter" data-mvi-counter aria-live="polite"></span>
    </div>

    {%- if block.settings.thumbnails != 'hidden' -%}
      <ul class="mvi-gallery__thumbs" data-mvi-thumbs role="list">
        {%- for media in mvi_product.media -%}
          <li class="mvi-gallery__thumb" data-mvi-media-id="{{ media.id }}">
            <button type="button" data-mvi-thumb="{{ media.id }}" aria-label="Show image {{ forloop.index }}">
              {{
                media.preview_image
                | image_url: width: 200
                | image_tag: loading: 'lazy', alt: media.alt, widths: '100, 200', sizes: '100px'
              }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                <span class="mvi-gallery__badge" aria-hidden="true">▶</span>
              {%- elsif media.media_type == 'model' -%}
                <span class="mvi-gallery__badge" aria-hidden="true">3D</span>
              {%- endif -%}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Variant image gallery",
  "target": "section",
  "javascript": "variant-images-block.js",
  "stylesheet": "variant-images.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    },
    {
      "type": "select",
      "id": "thumbnails",
      "label": "Thumbnails",
      "options": [
        { "value": "below", "label": "Below image" },
        { "value": "left", "label": "Left of image" },
        { "value": "hidden", "label": "Hidden" }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to first image" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Fit (show whole image)" },
        { "value": "cover", "label": "Fill (crop to ratio)" }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Colour filtering"
    },
    {
      "type": "select",
      "id": "fallback",
      "label": "Colours without assigned images show",
      "options": [
        { "value": "all", "label": "All product images" },
        { "value": "shared", "label": "Only images not assigned to a colour" }
      ],
      "default": "all"
    },
    {
      "type": "checkbox",
      "id": "include_shared",
      "label": "Also show images that aren't assigned to any colour",
      "default": false
    }
  ]
}
{% endschema %}
